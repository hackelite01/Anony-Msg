TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_SECRET=replace-with-long-random-string
CHANNEL_ID=
CHANNEL_USERNAME=
# Optional: a private channel where the bot will post activity logs
# (new users, SMS sent/failed, payments, key assignments, refunds).
# The bot must be added to this channel as an administrator.
LOG_CHANNEL_ID=
ADMIN_USER_IDS=123456,789012
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=anonsmbot
WELCOME_GIF_URL=
SUPPORT_CHANNEL_URL=
SMS_SENDER_NAME=Anonymous
PORT=8000
# Set to true for local development (uses long polling instead of webhook).
# Leave false (or unset) in production on Render.
USE_POLLING=false

# --- TON payments (optional) ---
# Receiving wallet; can also be set in /admin -> Settings -> Set TON Wallet.
TON_WALLET_ADDRESS=
# Optional TON Center API key (https://toncenter.com) for higher rate limits.
TONCENTER_API_KEY=
# How often to scan for payments, and how long an order stays valid.
TON_POLL_SECONDS=20
TON_ORDER_TTL_MINUTES=60

# --- Bitcoin payments (optional) ---
# Set the address and switch it on in /admin -> Settings -> Payment Methods.
# Esplora-compatible APIs, tried in order (first that answers wins).
BTC_API_URLS=https://mempool.space,https://blockstream.info
BTC_MIN_CONFIRMATIONS=1
BTC_POLL_SECONDS=60
BTC_ORDER_TTL_MINUTES=60

# Colored inline/reply buttons (blue/green/red). Set false for plain grey buttons.
BUTTON_STYLES=true
